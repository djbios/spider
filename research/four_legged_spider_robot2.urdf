<robot name="spider_robot">

  <!-- Base link -->
  <link name="base_link"/>

  <!-- Leg 1 -->
  <joint name="hip_joint_1" type="revolute">
    <parent link="base_link"/>
    <child link="upper_leg_link_1"/>
    <origin xyz="0.04 0.02 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>
  <link name="upper_leg_link_1"/>
  <joint name="knee_joint_1" type="revolute">
    <parent link="upper_leg_link_1"/>
    <child link="lower_leg_link_1"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
  </joint>
  <link name="lower_leg_link_1"/>
  <joint name="ankle_joint_1" type="revolute">
    <parent link="lower_leg_link_1"/>
    <child link="foot_link_1"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
  </joint>
  <link name="foot_link_1"/>
  
  <!-- Leg 2 -->
  <joint name="hip_joint_2" type="revolute">
    <parent link="base_link"/>
    <child link="upper_leg_link_2"/>
    <origin xyz="-0.04 0.02 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>
  <link name="upper_leg_link_2"/>
  <joint name="knee_joint_2" type="revolute">
    <parent link="upper_leg_link_2"/>
    <child link="lower_leg_link_2"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
  </joint>
  <link name="lower_leg_link_2"/>
  <joint name="ankle_joint_2" type="revolute">
    <parent link="lower_leg_link_2"/>
    <child link="foot_link_2"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
  </joint>
  <link name="foot_link_2"/>
  
  <!-- Leg 3 -->
  <joint name="hip_joint_3" type="revolute">
    <parent link="base_link"/>
    <child link="upper_leg_link_3"/>
    <origin xyz="0.04 -0.02 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>
  <link name="upper_leg_link_3"/>
  <joint name="knee_joint_3" type="revolute">
    <parent link="upper_leg_link_3"/>
    <child link="lower_leg_link_3"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
  </joint>
  <link name="lower_leg_link_3"/>
  <joint name="ankle_joint_3" type="revolute">
    <parent link="lower_leg_link_3"/>
    <child link="foot_link_3"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
  </joint>
  <link name="foot_link_3"/>
  
  <!-- Leg 4 -->
  <joint name="hip_joint_4" type="revolute">
    <parent link="base_link"/>
    <child link="upper_leg_link_4"/>
    <origin xyz="-0.04 -0.02 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>
  <link name="upper_leg_link_4"/>
  <joint name="knee_joint_4" type="revolute">
    <parent link="upper_leg_link_4"/>
    <child link="lower_leg_link_4"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
  </joint>
  <link name="lower_leg_link_4"/>
  <joint name="ankle_joint_4" type="revolute">
    <parent link="lower_leg_link_4"/>
    <child link="foot_link_4"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
  </joint>
  <link name="foot_link_4"/>

</robot>
